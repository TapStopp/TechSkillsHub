// TechSkillsHub Prisma schema — SQLite (development) / PostgreSQL (production).
// Run: npx prisma migrate dev  then  npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  FACULTY
  ALUMNI
  INDUSTRY_PARTNER
  ADMIN
  ORG_LEADER
}

enum EventCategory {
  WORKSHOP
  CAREER_FAIR
  TECH_TALK
  HACKATHON
  CLUB_MEETING
  INTERVIEW_PREP
  NETWORKING
  SERVICE
  SOCIAL
}

enum RsvpStatus {
  GOING
  WAITLIST
  CANCELLED
}

enum CheckInMethod {
  QR
  MOBILE
  REMOTE
  MANUAL
}

enum CredentialStatus {
  SAVED
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MentorshipKind {
  RESEARCH
  INTERNSHIP
  PORTFOLIO_REVIEW
  CAREER_GUIDANCE
  MOCK_INTERVIEW
}

enum ApplicationStatus {
  APPLIED
  ACCEPTED
  DECLINED
  MATCHED
}

enum Role {
  President
  VicePresident
  Secretary
  Treasurer
  Advisor
  SystemAdmin
  Faculty
  Student
  Other
}

enum CredentialProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  COMPLETED_WITH_PROOF
  VERIFIED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CompanyType {
  FAANG
  STARTUP
  ENTERPRISE
  NONPROFIT
}

enum Semester {
  SPRING
  FALL
  SUMMER
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          UserRole  @default(STUDENT)
  clubRole      Role?     @default(Student)
  club          String?   // Club name/ID user is associated with
  department    String?   // CS, Cybersecurity, IT, Math, Game Design, etc.
  avatarColor   String    @default("#a4123f")
  title         String?
  company       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile StudentProfile?
  memberships    Membership[]
  rsvps          Rsvp[]
  checkIns       CheckIn[]
  reflections    Reflection[]
  userBadges     UserBadge[]
  pathwayProgress UserPathwayProgress[]
  competencyProgress UserCompetencyProgress[]
  userCredentials UserCredential[]
  portfolioItems PortfolioItem[]
  mentorshipApplications MentorshipApplication[]
  mentorshipOffered MentorshipOpportunity[] @relation("MentorOpportunities")
  interviewBookings InterviewBooking[]
  interviewSlots InterviewSlot[] @relation("InterviewerSlots")
  transcriptEntries TranscriptEntry[]
  xpTransactions XpTransaction[]
  
  // Club & follow relationships
  clubMemberships ClubMember[]
  clubFollows UserClubFollow[]
  announcementsPoster ClubAnnouncement[] @relation("AnnouncementPostedBy")
  
  // Credential tracking
  credentialProgress UserCredentialProgress[]
  credentialVerifications UserCredentialProgress[] @relation("VerifiedBy")
  
  // Micro-projects
  microProjects UserMicroProject[]
  projectApprovals UserMicroProject[] @relation("ApprovedBy")
  
  // Interview challenges
  interviewSubmissions InterviewSubmission[]
  interviewFeedback InterviewFeedback[]
  
  // Admin & audit
  auditLogs AuditLog[]
  
  // Faculty
  faculty Faculty?
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  major        String
  gradYear     Int
  careerTrack  String
  interests    String[]
  summary      String?
  totalXp      Int      @default(0)
  level        Int      @default(1)
  serviceHours Float    @default(0)
}

// ---------------------------------------------------------------------------
// Organizations & membership
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String
  logoColor   String   @default("#a4123f")
  memberCount Int      @default(0)

  memberships Membership[]
  events      Event[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("MEMBER") // MEMBER | OFFICER | PRESIDENT

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id          String        @id @default(cuid())
  title       String
  description String
  category    EventCategory
  startsAt    DateTime
  endsAt      DateTime
  location    String
  isRemote    Boolean       @default(false)
  capacity    Int           @default(50)
  xpReward    Int           @default(50)
  isCsmSpecific Boolean     @default(true)
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])
  competencyTag String?

  rsvps       Rsvp[]
  checkIns    CheckIn[]
  reflections Reflection[]
  badges      Badge[]       @relation("EventBadges")
}

model Rsvp {
  id        String     @id @default(cuid())
  userId    String
  eventId   String
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model CheckIn {
  id        String        @id @default(cuid())
  userId    String
  eventId   String
  method    CheckInMethod @default(QR)
  xpAwarded Int           @default(0)
  createdAt DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  content   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Badge {
  id          String  @id @default(cuid())
  name        String
  description String
  category    String
  icon        String  @default("award")
  tier        String  @default("bronze") // bronze | silver | gold | platinum
  xpValue     Int     @default(100)

  userBadges UserBadge[]
  events     Event[]     @relation("EventBadges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  progress  Int      @default(100) // percent toward earning

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Pathways & competencies
// ---------------------------------------------------------------------------

model Pathway {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  estimatedHours Int   @default(20)

  steps    PathwayStep[]
  progress UserPathwayProgress[]
}

model PathwayStep {
  id        String @id @default(cuid())
  pathwayId String
  title     String
  detail    String
  order     Int

  pathway Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
}

model UserPathwayProgress {
  id            String         @id @default(cuid())
  userId        String
  pathwayId     String
  status        ProgressStatus @default(IN_PROGRESS)
  completedSteps Int           @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayId])
}

model Competency {
  id          String @id @default(cuid())
  name        String
  framework   String @default("NACE") // NACE | CSM
  description String
  category    String

  progress UserCompetencyProgress[]
}

model UserCompetencyProgress {
  id           String @id @default(cuid())
  userId       String
  competencyId String
  level        Int    @default(1) // 1-5
  percent      Int    @default(0)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([userId, competencyId])
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

model Credential {
  id          String @id @default(cuid())
  name        String
  provider    String
  careerTrack String
  major       String
  cost        String
  difficulty  String
  duration    String
  modality    String
  description String
  url         String?

  userCredentials UserCredential[]
}

model UserCredential {
  id           String           @id @default(cuid())
  userId       String
  credentialId String
  status       CredentialStatus @default(SAVED)
  updatedAt    DateTime         @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialId])
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

model PortfolioItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String   // PROJECT | FILE | LINK | GITHUB | LINKEDIN
  url         String?
  description String
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Mentorship & interviews
// ---------------------------------------------------------------------------

model MentorshipOpportunity {
  id          String         @id @default(cuid())
  mentorId    String
  kind        MentorshipKind
  title       String
  description String
  careerTrack String
  expertise   String[]
  availability String
  isOpen      Boolean        @default(true)

  mentor       User                    @relation("MentorOpportunities", fields: [mentorId], references: [id], onDelete: Cascade)
  applications MentorshipApplication[]
}

model MentorshipApplication {
  id             String            @id @default(cuid())
  userId         String
  opportunityId  String
  status         ApplicationStatus @default(APPLIED)
  message        String?
  createdAt      DateTime          @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity MentorshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model InterviewSlot {
  id            String   @id @default(cuid())
  interviewerId String
  topic         String
  startsAt      DateTime
  durationMin   Int      @default(45)
  modality      String   @default("Remote")
  isBooked      Boolean  @default(false)

  interviewer User              @relation("InterviewerSlots", fields: [interviewerId], references: [id], onDelete: Cascade)
  bookings    InterviewBooking[]
}

model InterviewBooking {
  id        String   @id @default(cuid())
  userId    String
  slotId    String   @unique
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Co-curricular transcript
// ---------------------------------------------------------------------------

model TranscriptEntry {
  id        String   @id @default(cuid())
  userId    String
  category  String   // EVENT | LEADERSHIP | SERVICE | CREDENTIAL | BADGE
  title     String
  detail    String
  hours     Float    @default(0)
  occurredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Clubs & Community
// ---------------------------------------------------------------------------

model Club {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String
  location      String?
  meetingTimes  String?  // JSON: [{day: "Monday", time: "5:00 PM"}, ...]
  meetingDays   String[] // ["Monday", "Wednesday"]
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       ClubMember[]
  announcements ClubAnnouncement[]
  followers     UserClubFollow[]
}

model ClubMember {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role      Role     @default(Student)
  joinedAt  DateTime @default(now())

  @@unique([userId, clubId])
}

model ClubAnnouncement {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title        String
  content      String
  attachmentUrl String? // URL to PDF or file
  year         Int?     // 2026
  semester     Semester? // SPRING, FALL, SUMMER
  postedById   String
  postedBy     User     @relation("AnnouncementPostedBy", fields: [postedById], references: [id], onDelete: Cascade)
  archived     Boolean  @default(false)
  postedAt     DateTime @default(now())
}

model UserClubFollow {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  followedAt DateTime @default(now())

  @@unique([userId, clubId])
}

// ---------------------------------------------------------------------------
// Credentials & Roadmaps
// ---------------------------------------------------------------------------

model Roadmap {
  id               String   @id @default(cuid())
  title            String   @unique
  slug             String   @unique
  description      String
  category         String   // Cybersecurity, Cloud Engineering, Software Dev, Data/AI, etc.
  difficulty       Difficulty @default(INTERMEDIATE)
  estimatedHours   Int      @default(40)
  icon             String   @default("rocket")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  steps RoadmapStep[]
}

model RoadmapStep {
  id               String   @id @default(cuid())
  roadmapId        String
  roadmap          Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  stepNumber       Int
  title            String
  description      String
  credentialId     String?
  competencyIds    String[] // JSON array of competency IDs
  estimatedHours   Int      @default(5)
  reasoning        String   // Why this step matters
}

model UserCredentialProgress {
  id               String   @id @default(cuid())
  userId           String
  credentialId     String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential       Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  status           CredentialProgressStatus @default(NOT_STARTED)
  completedAt      DateTime?
  proofFileUrl     String?  // URL to uploaded proof (PDF/screenshot)
  verifiedById     String?  // User who verified
  verifiedBy       User?    @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?

  @@unique([userId, credentialId])
}

// ---------------------------------------------------------------------------
// Micro-Projects & Portfolio
// ---------------------------------------------------------------------------

model UserMicroProject {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String
  githubUrl        String?
  demoUrl          String?
  screenshotUrl    String?  // Original uploaded image
  thumbnailUrl     String?  // 150x150 thumbnail (Sharp processed)
  mediumImageUrl   String?  // 400x400 medium (Sharp processed)
  submittedAt      DateTime @default(now())
  approvedById     String?  // Admin who approved
  approvedBy       User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Interview Challenges & Prep
// ---------------------------------------------------------------------------

model InterviewChallenge {
  id               String   @id @default(cuid())
  title            String   @unique
  description      String
  prompt           String   // The challenge text/code/prompt
  difficulty       Difficulty @default(INTERMEDIATE)
  companyType      CompanyType? // FAANG, startup, etc.
  category         String   // Coding, Systems Design, Cloud, etc.
  sampleSolution   String?  // Example solution
  createdAt        DateTime @default(now())

  submissions InterviewSubmission[]
}

model InterviewSubmission {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId      String
  challenge        InterviewChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  code             String   // Submitted solution code
  submittedAt      DateTime @default(now())
  feedbackRequested Boolean  @default(false)

  feedback InterviewFeedback?
}

model InterviewFeedback {
  id               String   @id @default(cuid())
  submissionId     String   @unique
  submission       InterviewSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  feedback         String   // Feedback text
  score            Int?     // 1-100
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Faculty & Mentorship
// ---------------------------------------------------------------------------

model Faculty {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String   // CS, Cybersecurity, IT, Math, Game Design, etc.
  officeHours      String?  // JSON: [{day: "Monday", time: "2:00 PM", location: "..."}, ...]
  expertiseAreas   String[] // ["AI", "Cybersecurity", "Game Development"]
  linkedCredentials String[] // Credential IDs related to this faculty
  linkedChallenges String[] // Challenge IDs related to this faculty
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Employer Skills & Analytics
// ---------------------------------------------------------------------------

model EmployerSkillDemand {
  id               String   @id @default(cuid())
  skill            String   @unique
  demandPercent    Float    @default(0) // 0-100
  relatedCompanies String[] // ["Google", "Microsoft", "Amazon"]
  jobPostings      Int      @default(0)
  updatedAt        DateTime @updatedAt
  source           String   @default("external_api") // external_api, manual, etc.
}

// ---------------------------------------------------------------------------
// Audit & Compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id               String   @id @default(cuid())
  action           String   // "role_changed", "proof_verified", "project_approved", etc.
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType       String?  // "User", "Credential", "Project", etc.
  targetId         String?  // ID of the affected resource
  changes          String?  // JSON: what changed
  timestamp        DateTime @default(now())
}
